# Copy this file to .env and adjust values as needed
# NO API KEYS REQUIRED — everything runs locally

# Ollama (local LLM — no API key)
# Start Ollama with: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local embedding model (no API key)
# Auto-downloads ~22MB on first run to ~/.cache/huggingface/
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to backend/ folder)
CHROMA_PERSIST_DIR=./chroma_db

# Whisper model size: tiny | base | small | medium | large
# "base" is the recommended balance of speed and accuracy for local use
# Auto-downloads ~140MB on first run to ~/.cache/whisper/
WHISPER_MODEL=base
