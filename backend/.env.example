# Copy this file to .env and adjust values as needed
# NO API KEYS REQUIRED — everything runs locally

# Ollama (local LLM — no API key)
# Start Ollama with: ollama serve
# Then pull the model with: ollama pull llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Local embedding model (no API key)
# Auto-downloads ~22MB on first run to ~/.cache/huggingface/
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to backend/ folder)
CHROMA_PERSIST_DIR=./chroma_db

# Whisper model size for audio transcription (used as fallback when captions unavailable)
# tiny  = fastest (recommended for demos and reels under 2 minutes)
# base  = better accuracy for longer videos
# small = best accuracy, use only if you have 8GB+ RAM and don't mind slower startup
# Auto-downloads on first run to ~/.cache/huggingface/hub/
WHISPER_MODEL=tiny

# Path to your exported Instagram cookies file (Netscape format)
# Export using Cookie-Editor browser extension after logging into Instagram
# Re-export if stats stop working (cookies expire every few weeks)
INSTAGRAM_COOKIES_PATH=./instagram_cookies.txt
